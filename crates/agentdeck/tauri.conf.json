{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "AgentDeck",
  "version": "0.3.1",
  "identifier": "com.mantou.agentdeck",
  "build": {
    "beforeDevCommand": "pnpm -C packages/agentdeck dev",
    "devUrl": "http://localhost:1420",
    "beforeBuildCommand": "pnpm -C packages/agentdeck build",
    "frontendDist": "../../packages/agentdeck/dist"
  },
  "app": {
    "withGlobalTauri": true,
    "windows": [
      {
        "useHttpsScheme": true,
        "label": "main",
        "title": "AgentDeck",
        "width": 430,
        "height": 860,
        "minWidth": 360,
        "minHeight": 640,
        "center": true
      }
    ],
    "security": {
      "csp": null
    }
  },
  "bundle": {
    "active": true,
    "targets": "all",
    "icon": ["icons/32x32.png", "icons/128x128.png", "icons/128x128@2x.png", "icons/icon.icns", "icons/icon.ico"]
  }
}
