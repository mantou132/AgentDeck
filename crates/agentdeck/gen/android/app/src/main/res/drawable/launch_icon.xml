<?xml version="1.0" encoding="utf-8"?>
<!-- Android 12's 288dp icon canvas contains an 80dp icon. -->
<layer-list xmlns:android="http://schemas.android.com/apk/res/android">
    <item android:width="288dp" android:height="288dp">
        <shape android:shape="rectangle">
            <solid android:color="@android:color/transparent" />
            <size android:width="288dp" android:height="288dp" />
        </shape>
    </item>
    <item android:width="80dp" android:height="80dp" android:gravity="center"
        android:drawable="@mipmap/ic_launcher" />
</layer-list>
