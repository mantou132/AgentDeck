{
  "compilerOptions": {
    "strict": true,
    "strictPropertyInitialization": false,
    "isolatedModules": true,
    "verbatimModuleSyntax": true,
    "module": "ESNext",
    "moduleResolution": "bundler",
    "skipLibCheck": true,
    "target": "ES2022",
    "lib": ["ESNext", "DOM", "DOM.Iterable"],
    "noEmit": true,
    "baseUrl": "."
  },
  "include": ["src"]
}
