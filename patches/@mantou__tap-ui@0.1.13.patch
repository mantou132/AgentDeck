+/** 移动超过该距离视为滑动，不再触发 */
+const LONG_PRESS_MOVE_TOLERANCE = 10;
+class LongPressDirective extends Directive {
+    #element;
+    #action;
+    #options;
+    #press;
+    constructor(partInfo) {
+        super();
+        if (partInfo.type !== PartType.ELEMENT) {
+            throw new Error('longPress can only be used on elements');
+        }
+    }
+    #cancel = () => {
+        if (this.#press)
+            window.clearTimeout(this.#press.timer);
+        this.#press = undefined;
+    };
+    #start = (evt) => {
+        if (evt.button !== 0 || this.#options?.disabled)
+            return;
+        this.#cancel();
+        const press = {
+            x: evt.clientX,
+            y: evt.clientY,
+            fired: false,
+            timer: window.setTimeout(() => {
+                press.fired = true;
+                this.#action?.();
+            }, this.#options?.delay ?? 500),
+        };
+        this.#press = press;
+    };
+    #move = (evt) => {
+        const press = this.#press;
+        if (press && !press.fired && Math.hypot(evt.clientX - press.x, evt.clientY - press.y) > LONG_PRESS_MOVE_TOLERANCE) {
+            this.#cancel();
+        }
+    };
+    #end = () => {
+        const fired = this.#press?.fired;
+        this.#cancel();
+        if (fired)
+            this.#options?.release?.();
+    };
+    // 长按会弹出系统菜单（粘贴、选词等），启用时以及已触发未松开时屏蔽
+    #onContextMenu = (evt) => {
+        if (!this.#options?.disabled || this.#press?.fired)
+            evt.preventDefault();
+    };
+    _$notifyDirectiveConnectionChanged(isConnected) {
+        if (!isConnected) {
+            this.#cancel();
+        }
+    }
+    update(part, [action, options]) {
+        this.#action = action;
+        this.#options = options;
+        // 已触发时保留，松开时仍要调用 `release`
+        if (options?.disabled && !this.#press?.fired) {
+            this.#cancel();
+        }
+        if (this.#element !== part.element) {
+            if (this.#element) {
+                this.#element.removeEventListener('pointerdown', this.#start);
+                this.#element.removeEventListener('pointermove', this.#move);
+                this.#element.removeEventListener('pointerup', this.#end);
+                this.#element.removeEventListener('pointercancel', this.#cancel);
+                this.#element.removeEventListener('contextmenu', this.#onContextMenu);
+            }
+            this.#element = part.element;
+            this.#element.addEventListener('pointerdown', this.#start);
+            this.#element.addEventListener('pointermove', this.#move);
+            this.#element.addEventListener('pointerup', this.#end);
+            this.#element.addEventListener('pointercancel', this.#cancel);
+            this.#element.addEventListener('contextmenu', this.#onContextMenu);
+        }
+        return this.render(action, options);
+    }
