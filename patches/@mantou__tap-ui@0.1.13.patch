+    static menuSeparator: string;
+    menu?: CalloutItem[];
+    open: boolean;
+    /** 长按浮起、菜单弹出时触发，可用于震动反馈 */
+    show: Emitter;
+    static open({ target, preview, menu }: CalloutOptions): Promise<void>;
+    render: () => TemplateResult;
+}
+export declare const Callout: typeof TapCalloutElement;
